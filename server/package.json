{
  "name": "@tripfund/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "migrate": "node src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:schema": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -q -f test/schema.test.sql",
    "check:sql": "node scripts/check-sql.ts",
    "test:unit": "node --test test/unit.test.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "pdfkit": "^0.17.1",
    "pg": "^8.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.14.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.0"
  }
}
